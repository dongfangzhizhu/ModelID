# ============================================================
# Rust
# ============================================================
/target/
**/*.rs.bk
# Cargo.lock is intentionally tracked: this is a binary crate, and a locked
# dependency graph is what makes the release reproducible.

# ============================================================
# Python: build and cache artifacts
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
python/dist/
python/build/
python/.eggs/
*.egg-info/
*.whl
*.tar.gz

# ============================================================
# Python: virtual environments and local secrets
# ============================================================
.venv/
venv/
env/
.env
.env.local

# ============================================================
# Node: dependencies only
# ============================================================
# `crates/modeld-webui/ui` is a small npm project whose `package.json` and
# `package-lock.json` are tracked so `npm ci` in CI is reproducible. Only the
# installed tree is ignored; the old rules re-included it by accident.
node_modules/
npm-debug.log*

# ============================================================
# IDE and editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.kiro/

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# modeld: local dev and test artifacts
# ============================================================
/test-store/
/.modeld-test/
/.modeld/
*.db
*.db-wal
*.db-shm
*.log
quarantine/

# ============================================================
# Secrets and credentials
# ============================================================
.pypirc
pypirc
*.pem
*.key

# ============================================================
# Local development planning docs (internal, not for publishing)
