node_modules/
package-lock.json
# But exclude node_modules installed there
!/crates/modeld-webui/ui/node_modules/
package.json
# Exception: modeld-webui/ui has a minimal package.json to run its
# frontend property/unit tests (node:test + fast-check) 鈥?track it.
!/crates/modeld-webui/ui/package.json
!/crates/modeld-webui/ui/package-lock.json
# But exclude node_modules installed there
!/crates/modeld-webui/ui/node_modules/

