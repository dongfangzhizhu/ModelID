# 发布相关的 .gitignore 规则
# 请将这些规则添加到项目根目录的 .gitignore 文件中

# PyPI 打包文件
python/dist/
python/build/
python/*.egg-info/
python/.eggs/

# 发布工具
.pypirc
pypirc

# Python 缓存
python/__pycache__/
python/tests/__pycache__/
python/modeld_hook/__pycache__/
python/.pytest_cache/

# IDE 文件
.vscode/
.idea/
*.swp
*.swo
*~

# OS 文件
.DS_Store
Thumbs.db

# 分发
*.whl
*.tar.gz
*.zip
